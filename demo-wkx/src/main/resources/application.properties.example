spring.application.name=demo-wkx

# === LLM Configuration ===
# 通义千问 Qwen API (阿里云DashScope, OpenAI兼容接口)
# 申请API Key: https://dashscope.console.aliyun.com
llm.api-key=YOUR_DASHSCOPE_API_KEY_HERE
llm.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
llm.model=qwen-turbo
llm.system-prompt=你是一个友好的微信AI助手，请用简洁的中文回答用户的问题。当用户问你是谁时，说你是基于通义千问大模型的微信AI助手。

# === Vision API Configuration (图片理解) ===
# 通义千问视觉模型，使用同一个API Key
llm.vision-base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
llm.vision-api-key=YOUR_DASHSCOPE_API_KEY_HERE
llm.vision-model=qwen-vl-plus

# === Weather API Configuration ===
weather.api-key=YOUR_SENIVERSE_API_KEY_HERE

# === RAG Configuration ===
rag.enabled=true

# === Logging Configuration ===
# 日志时间使用北京时间格式
logging.pattern.dateformat=yyyy-MM-dd HH:mm:ss.SSS

# === Server Configuration ===
server.port=8080
